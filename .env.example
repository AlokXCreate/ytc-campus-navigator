# ==========================================
# YTC CAMPUS NAVIGATOR - ROOT ENVIRONMENT VARIABLES
# Yashoda Technical Campus, Satara, Maharashtra
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=False

# Backend FastAPI Configuration
APP_NAME="YTC Campus Navigator API"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./campus.db
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
PORT=3000

# Institution Metadata Defaults
VITE_INSTITUTION_NAME="Yashoda Technical Campus"
VITE_INSTITUTION_LOCATION="Satara, Maharashtra, India"
VITE_CAMPUS_LAT=17.7215
VITE_CAMPUS_LNG=74.0205
